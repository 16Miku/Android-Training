<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Property_Animation_Activity">



    <!-- 新增的 FrameLayout 作为背景容器 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:layout_marginTop="0dp"
        android:background="@color/red"
        android:gravity="center">

        <ImageView
            android:id="@+id/property_image_view"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:src="@drawable/ultraman"
            android:layout_gravity="center"

            android:background="@android:color/transparent" />

    </FrameLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        >

        <Button
            android:id="@+id/start_animation_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="开始动画" />

        <Button
            android:id="@+id/stop_animation_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="停止动画" />


        <Button
            android:id="@+id/to_tween_animation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="前往补间动画" />


    </LinearLayout>



</LinearLayout>